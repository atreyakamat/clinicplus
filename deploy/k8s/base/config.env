# Non-secret API configuration → ConfigMap clinicplus-config (configMapGenerator, hashed name:
# changing a value rolls the API automatically). Secrets: see secret.example.yaml.
NODE_ENV=production
PORT=3000
LOG_LEVEL=log
# Requests arrive via ingress → web nginx → api; nginx forwards the real client IP.
TRUST_PROXY=true
# Public origin of the app. The SPA and API share it (web nginx proxies /api), so CORS is
# same-origin and provider webhooks use https://<host>/api/v1/webhooks/...
APP_BASE_URL=https://clinic.example.com
API_PUBLIC_URL=https://clinic.example.com
CORS_ORIGINS=https://clinic.example.com
ACCESS_SYNC_ON_BOOT=true
CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_JSON_BODY_MB=2
MAX_UPLOAD_MB=10
# Pods are ephemeral and replicated → object storage. (`local` would need a ReadWriteMany PVC.)
STORAGE_DRIVER=s3
S3_BUCKET=clinicplus-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
UPLOAD_DIR=/app/storage/uploads
MALWARE_SCAN=off
# Backups are taken by the clinicplus-backup CronJob, not by API replicas.
BACKUP_SCHEDULE_ENABLED=false
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
BACKUP_TO_S3=true
BACKUP_S3_PREFIX=backups/
# Reminder/campaign jobs; safe with N replicas (Postgres advisory locks).
SCHEDULER_ENABLED=true
REMINDER_INTERVAL_MINUTES=15
MAIL_PROVIDER=console
# MAIL_FROM="Clinic <no-reply@example.com>"  (MAIL_API_KEY goes in the Secret)
MESSAGING_PROVIDER=console
PAYMENTS_PROVIDER=none
SENTRY_TRACES_SAMPLE_RATE=0.1
