# production overrides merged into clinicplus-config (base/config.env).
APP_BASE_URL=https://clinic.example.com
API_PUBLIC_URL=https://clinic.example.com
CORS_ORIGINS=https://clinic.example.com
S3_BUCKET=clinicplus-prod-files
S3_REGION=ap-south-1
# Switch on once the provider keys are in clinicplus-secrets (the API validates them at boot):
# PAYMENTS_PROVIDER=stripe
# MESSAGING_PROVIDER=twilio
PAYMENTS_PROVIDER=none
MESSAGING_PROVIDER=console
LOG_LEVEL=log
