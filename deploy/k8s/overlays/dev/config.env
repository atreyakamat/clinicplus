# dev overrides merged into clinicplus-config (base/config.env).
APP_BASE_URL=http://clinicplus.localtest.me
API_PUBLIC_URL=http://clinicplus.localtest.me
CORS_ORIGINS=http://clinicplus.localtest.me
LOG_LEVEL=debug
# In-cluster MinIO
S3_BUCKET=clinicplus
S3_ENDPOINT=http://clinicplus-minio:9000
S3_FORCE_PATH_STYLE=true
# MinIO without a KMS rejects SSE headers on upload
BACKUP_S3_SSE=
BACKUP_RETENTION_DAYS=3
