# Dev-cluster secrets. Copy to secrets.env (git-ignored) and change the values:
#   cp secrets.env.example secrets.env
# Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical (URL-safe chars only),
# and S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are also MinIO's root credentials.
POSTGRES_PASSWORD=dev-only-postgres-password
DATABASE_URL=postgresql://clinicplus:dev-only-postgres-password@clinicplus-postgres:5432/clinicplus?schema=public
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
S3_ACCESS_KEY_ID=clinicplus
S3_SECRET_ACCESS_KEY=dev-only-minio-password
