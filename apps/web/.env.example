# ClinicPlus web (Vite). Copy to .env.local for local overrides. Never commit secrets.
# API base path. Leave as /api/v1 when the dev server proxy or nginx forwards /api to the API.
VITE_API_BASE_URL=/api/v1
# Optional Sentry DSN for the browser bundle (session replay is masked; disabled when empty)
VITE_SENTRY_DSN=
