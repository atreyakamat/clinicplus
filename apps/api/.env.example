# ---------------------------------------------------------------------------
# ClinicPlus API environment (copy to .env; never commit real values)
# Full reference: docs/ENVIRONMENT_VARIABLES.md
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development                 # development | test | production
PORT=3000
LOG_LEVEL=log                        # error | warn | log | debug | verbose
TRUST_PROXY=false                    # true when behind nginx/ALB so client IPs are correct

# Database (PostgreSQL 15+). Use a dedicated role; never the superuser.
DATABASE_URL=postgresql://clinicos:change-me@localhost:5432/clinicos_db?schema=public

# Auth
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=1h                    # access token lifetime (zeit/ms format)
SESSION_TTL_DAYS=7                   # refresh-token session absolute lifetime
LOGIN_MAX_FAILED_ATTEMPTS=5          # per e-mail within LOGIN_LOCKOUT_MINUTES
LOGIN_LOCKOUT_MINUTES=15

# HTTP
CORS_ORIGINS=http://localhost:5173   # comma-separated allowed browser origins
APP_BASE_URL=http://localhost:5173   # public web URL used in links (invites, reviews, payment links)
# API_PUBLIC_URL=https://clinic.example.com  # public origin for provider callbacks (Twilio). Leave commented when unknown: an empty value fails validation
ACCESS_SYNC_ON_BOOT=true             # sync built-in roles/permissions to every org at boot
CURRENCY=INR                         # ISO 4217
MAX_JSON_BODY_MB=2
DEFAULT_TIMEZONE=Asia/Kolkata        # used for day boundaries when a branch has no timezone

# File storage (private; outside any web root)
STORAGE_DRIVER=local                 # local (UPLOAD_DIR) | s3 (any S3-compatible store)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                         # empty for AWS; e.g. http://localhost:9000 for MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false            # true for MinIO
MALWARE_SCAN=off                     # off | clamav
CLAMAV_HOST=
CLAMAV_PORT=3310

# Backups (pg_dump must be on PATH)
BACKUP_DIR=./storage/backups
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_ENABLED=false        # true in production: daily dump at BACKUP_HOUR_LOCAL
BACKUP_HOUR_LOCAL=2
BACKUP_ENCRYPTION_KEY=               # optional 64-hex-char key -> AES-256-GCM encrypted dumps

# Background jobs
SCHEDULER_ENABLED=false              # true in production: reminder jobs every REMINDER_INTERVAL_MINUTES
REMINDER_INTERVAL_MINUTES=15

# E-mail (staff invitations, password resets)
MAIL_PROVIDER=console              # console (logs only, never sends) | resend | sendgrid
MAIL_API_KEY=
MAIL_FROM=                         # e.g. "Sunrise Clinic <no-reply@yourclinic.com>"

# Messaging (SMS / WhatsApp)
MESSAGING_PROVIDER=console           # console (never sends; logs + records) | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                     # E.164, e.g. +1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=                # e.g. whatsapp:+14155238886 (sandbox) or approved sender

# Payments
PAYMENTS_PROVIDER=none               # none | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=               # webhook endpoint: {API_PUBLIC_URL or APP origin}/api/v1/webhooks/stripe

# Error reporting (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Seeding (local/demo only). The seed refuses to run against non-local hosts unless ALLOW_SEED=true
SEED_PASSWORD=
ALLOW_SEED=false
