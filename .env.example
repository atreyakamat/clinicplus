# -----------------------------------------------------------------------------
# ClinicPlus — Docker Compose environment (copy to `.env` next to docker-compose.yml).
# NEVER commit the real .env. Values below are placeholders; anything marked REQUIRED
# makes `docker compose` refuse to start when empty.
# Generate secrets with:  openssl rand -hex 32
# For local (non-Docker) API development use apps/api/.env.example instead.
# -----------------------------------------------------------------------------

# ---- Images (optional) ------------------------------------------------------
# Leave unset to build locally. To run released images instead:
#   API_IMAGE=ghcr.io/atreyakamat/clinicplus-api:<sha>  WEB_IMAGE=ghcr.io/atreyakamat/clinicplus-web:<sha>
#   docker compose pull && docker compose up -d --no-build
# API_IMAGE=
# WEB_IMAGE=

# ---- Public URLs ------------------------------------------------------------
# URL users open in the browser (used in invite/review/payment links). https:// in production.
APP_BASE_URL=http://localhost
# Browser origins allowed by CORS. The SPA is same-origin (nginx proxies /api), so this is
# normally just APP_BASE_URL.
CORS_ORIGINS=http://localhost
# Public URL of the API for provider callbacks (Twilio status callbacks). With this compose
# file the API is served under the web origin, so use APP_BASE_URL (no /api suffix).
API_PUBLIC_URL=                     # empty → compose uses APP_BASE_URL
# Host interface/port that nginx is published on.
WEB_BIND=0.0.0.0
WEB_PORT=80

# ---- Database (PostgreSQL 16, in the `postgres` container) -------------------
POSTGRES_USER=clinicplus
# REQUIRED. Use URL-safe characters only (it is embedded in DATABASE_URL) — hex is ideal.
POSTGRES_PASSWORD=
POSTGRES_DB=clinicplus

# ---- Auth -------------------------------------------------------------------
# REQUIRED. Random string, >= 32 chars (the API refuses weak values in production).
JWT_SECRET=
JWT_ACCESS_TTL=1h
SESSION_TTL_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- General ----------------------------------------------------------------
LOG_LEVEL=log                       # error | warn | log | debug | verbose
CURRENCY=INR                        # ISO 4217, 3 letters
DEFAULT_TIMEZONE=Asia/Kolkata
ACCESS_SYNC_ON_BOOT=true            # sync built-in roles/permissions on API start (advisory-locked)
MAX_JSON_BODY_MB=2

# ---- File storage -----------------------------------------------------------
# local: files in the `api_storage` volume (single host).  s3: any S3-compatible store.
STORAGE_DRIVER=local
MAX_UPLOAD_MB=10
# nginx body limit for /api; keep >= MAX_UPLOAD_MB (+ multipart overhead).
CLIENT_MAX_BODY_SIZE=25m
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                        # empty for AWS; http://minio:9000 with --profile storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false           # true for MinIO
# Only used with `--profile storage` (MinIO). Set S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY to the
# same values (or create a dedicated MinIO user for the app).
MINIO_ROOT_USER=clinicplus
MINIO_ROOT_PASSWORD=change-me-minio-password

# ---- Malware scanning (`--profile av`) --------------------------------------
MALWARE_SCAN=off                    # off | clamav
CLAMAV_HOST=                        # clamav (the compose service name) when enabled
CLAMAV_PORT=3310

# ---- Backups (pg_dump inside the API container → `api_backups` volume) ------
BACKUP_SCHEDULE_ENABLED=true
BACKUP_HOUR_LOCAL=2
BACKUP_RETENTION_DAYS=14
# Optional 64 hex chars (openssl rand -hex 32) → AES-256-GCM encrypted dumps. Store it
# somewhere other than this server — without it encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY=

# ---- Background jobs --------------------------------------------------------
SCHEDULER_ENABLED=true              # reminders, follow-ups, campaigns (advisory-locked)
REMINDER_INTERVAL_MINUTES=15

# E-mail (staff invitations, password resets)
MAIL_PROVIDER=console              # console (logs only, never sends) | resend | sendgrid
MAIL_API_KEY=
MAIL_FROM=                         # e.g. "Sunrise Clinic <no-reply@yourclinic.com>"

# ---- Messaging (SMS / WhatsApp) ---------------------------------------------
MESSAGING_PROVIDER=console          # console (logs only, never sends) | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                    # E.164, e.g. +15551234567
TWILIO_WHATSAPP_FROM=               # e.g. whatsapp:+15551234567

# ---- Payments ---------------------------------------------------------------
PAYMENTS_PROVIDER=none              # none | stripe
STRIPE_SECRET_KEY=                  # sk_live_... / sk_test_...
STRIPE_WEBHOOK_SECRET=              # whsec_... from the Stripe webhook endpoint

# ---- Error reporting --------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Browser Sentry DSN (baked into the web bundle at build time) and the matching CSP host.
VITE_SENTRY_DSN=
CSP_CONNECT_EXTRA=                  # e.g. https://o123456.ingest.sentry.io
CSP_IMG_EXTRA=

# ---- Reverse proxy in front of this stack (optional) ------------------------
# If you terminate TLS on a proxy/LB in front of the web container, set its CIDR so nginx
# trusts its X-Forwarded-For (real client IPs for rate limiting) and X-Forwarded-Proto (HSTS).
REAL_IP_FROM=127.0.0.1/32

# ---- Demo seed (`docker compose --profile demo run --rm seed`) --------------
SEED_PASSWORD=
